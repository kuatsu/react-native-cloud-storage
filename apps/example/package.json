{
  "name": "react-native-cloud-storage-example",
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "rm -rf android && expo run:android",
    "ios": "rm -rf ios && expo run:ios",
    "test:harness:android": "react-native-harness --harnessRunner android",
    "test:harness:ios": "react-native-harness --harnessRunner ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "^55.0.2",
    "expo-crypto": "~55.0.8",
    "expo-document-picker": "~55.0.8",
    "expo-file-system": "~55.0.9",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-cloud-storage": "workspace:*",
    "react-native-safe-area-context": "5.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native-harness/platform-android": "1.6.0",
    "@react-native-harness/platform-apple": "1.6.0",
    "@react-native/metro-config": "0.83.2",
    "@types/react": "~19.2.14",
    "jest": "30.5.2",
    "pod-install": "^1.2.1",
    "react-native-harness": "1.6.0",
    "typescript": "~5.9.3"
  },
  "private": true
}
