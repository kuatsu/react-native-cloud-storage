{
  "name": "react-native-cloud-storage-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run docs:api && fumadocs-mdx && next dev",
    "build": "pnpm run docs:api && fumadocs-mdx && next build",
    "start": "next start",
    "docs:api": "typedoc --options typedoc.config.mts && node scripts/format-api-code.mjs",
    "typecheck": "pnpm run docs:api && fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "typedoc --options typedoc.config.mts && node scripts/format-api-code.mjs && fumadocs-mdx",
    "clean": "rm -rf .next .source content/docs/api"
  },
  "dependencies": {
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.73.0",
    "postcss": "8.5.30",
    "react-native-cloud-storage": "workspace:*",
    "tailwindcss": "4.3.3",
    "typedoc": "0.28.20",
    "typedoc-plugin-frontmatter": "1.3.3",
    "typedoc-plugin-markdown": "4.14.0",
    "typescript": "~5.9.3",
    "zod": "4.6.6"
  }
}
